<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.zavabank.interestcalculator.HealthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>InterestBootstrapServlet</servlet-name>
        <servlet-class>com.zavabank.interestcalculator.InterestBootstrapServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>InterestCalculateServlet</servlet-name>
        <servlet-class>com.zavabank.interestcalculator.InterestCalculateServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>InterestAccrueAllServlet</servlet-name>
        <servlet-class>com.zavabank.interestcalculator.InterestAccrueAllServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>InterestBootstrapServlet</servlet-name>
        <url-pattern>/internal/bootstrap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>InterestCalculateServlet</servlet-name>
        <url-pattern>/api/interest/calculate</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>InterestAccrueAllServlet</servlet-name>
        <url-pattern>/api/interest/accrue-all</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
